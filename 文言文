    document.getElementById('translate-progress').textContent = `題目 ${translateIndex + 1} / ${translateDeck.length}`;
    document.getElementById('translate-passage').textContent = q.passage;
    document.getElementById('translate-prompt').textContent = "請輸入白話翻譯(批改會比對關鍵詞):";

    const input = document.getElementById('translate-input');
    input.value = "";
    input.style.display = 'inline-block';
    input.disabled = false;
    input.focus();

    document.getElementById('translate-feedback').innerHTML = "";
    document.getElementById('translate-next-btn').style.display = 'none';
    document.getElementById('translate-reference').classList.remove('show');
}

function checkTranslateAnswer() {
    const input = document.getElementById('translate-input');
    if (input.disabled) return;
    const userAns = input.value.trim();
    if (!userAns) {
        document.getElementById('translate-feedback').innerHTML = "<span class='feedback-wrong'>請輸入翻譯。</span>";
        return;
    }

    const q = translateDeck[translateIndex];
    const userNorm = userAns.replace(/[，。；、,. ;:]/g, '');
    const matchedKeywords = q.keywords.filter(kw => userNorm.includes(kw));
    const isComplete = matchedKeywords.length === q.keywords.length;

    const feedback = document.getElementById('translate-feedback');
    if (isComplete) {
        feedback.innerHTML = `<span class='feedback-correct'>✓ 翻譯包含所有關鍵詞!</span><div class='feedback-hint'>命中關鍵詞:${matchedKeywords.join('、')}</div>`;
        input.disabled = true;
        document.getElementById('translate-next-btn').style.display = 'inline-block';
        document.getElementById('translate-next-btn').focus();
        document.getElementById('translate-ref-text').textContent = q.reference;
        document.getElementById('translate-reference').classList.add('show');
        if (translateFirstTry) addGamePoints(20);
    } else {
        const missing = q.keywords.filter(kw => !matchedKeywords.includes(kw));
        feedback.innerHTML = `<span class='feedback-wrong'>✗ 部分關鍵詞未命中。</span><div class='feedback-hint'>你的翻譯需要包含「${q.keywords.join('」、「')}」等詞。尚缺:${missing.join('、')}</div>`;
        translateFirstTry = false;
        input.focus();
        input.select();
    }
}

function nextTranslateQuestion() { translateIndex++; loadTranslateQuestion(); }
