function buildPeopleGame() {
    peopleSelectionMemory = [];
    gameScores['people'] = 0;
    if (currentActiveTabKey === 'people') document.getElementById('score-current').textContent = 0;

    const grid = document.getElementById('people-grid');
    grid.innerHTML = '';

    let cardDeck = [];
    peopleDatabase.forEach((item) => {
        cardDeck.push({ text: item.name, matchKey: item.name });
        cardDeck.push({ text: item.quote, matchKey: item.name });
    });

    cardDeck = shuffle(cardDeck);

    cardDeck.forEach(card => {
        const el = document.createElement('div');
        el.className = 'card';
        el.textContent = card.text;
        el.style.fontSize = "0.95rem";
        el.style.lineHeight = "1.3";
        el.setAttribute('data-matchkey', card.matchKey);
        el.onclick = function() { handlePeopleClick(el); };
        grid.appendChild(el);
    });
}

function handlePeopleClick(element) {
    if (element.classList.contains('matched') || peopleSelectionMemory.includes(element)) return;
    if (peopleSelectionMemory.length >= 2) return;

    element.classList.add('selected');
    peopleSelectionMemory.push(element);

    if (peopleSelectionMemory.length === 2) {
        const c1 = peopleSelectionMemory[0];
        const c2 = peopleSelectionMemory[1];
        if (c1.getAttribute('data-matchkey') === c2.getAttribute('data-matchkey')) {
            setTimeout(() => {
                c1.className = 'card matched';
                c2.className = 'card matched';
                peopleSelectionMemory = [];
                addGamePoints(25);
            }, 250);
        } else {
            setTimeout(() => {
                c1.classList.remove('selected');
                c2.classList.remove('selected');
                peopleSelectionMemory = [];
                addGamePoints(-5);
            }, 800);
        }
    }
}

