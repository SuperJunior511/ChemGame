    .vocab-card {
        height: auto;
        min-height: 56px;
        font-size: 1.05rem;
        line-height: 1.4;
    }
    .card {
        background: white;
        min-height: 75px;
        border-radius: 12px;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 1.05rem;
        font-weight: bold;
        cursor: pointer;
        box-shadow: 0 4px 8px rgba(0,0,0,0.06);
        border: 3px solid transparent;
        transition: all 0.2s ease;
        user-select: none;
        padding: 8px;
        box-sizing: border-box;
        color: #2c2418;
        text-align: center;
        line-height: 1.3;
    }
    .card:hover { transform: translateY(-3px); box-shadow: 0 6px 12px rgba(0,0,0,0.1); }
    .card.selected { border-color: #8b2c2c; background-color: #fce8e8; }
    .card.matched {
        background-color: #b58a23 !important;
        color: white !important;
        visibility: hidden;
        opacity: 0;
        transform: scale(0.8);
        pointer-events: none;
    }

    .quiz-container {
        max-width: 620px;
        background: white;
        margin: 20px auto;
        padding: 30px;
        border-radius: 20px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.05);
        display: none;
        text-align: left;
    }

    .passage-box {
        background: #fdf8ed;
        border-left: 5px solid #8b2c2c;
        padding: 14px 18px;
        margin: 10px auto 20px auto;
        border-radius: 4px;
        font-size: 1.05rem;
        line-height: 1.8;
        color: #2c2418;
        font-family: 'Microsoft JhengHei', 'PMingLiU', serif;
    }

    #sentence-question, #translate-prompt, #theme-question, #rhetoric-question {
        font-size: 1.2rem;
        font-weight: bold;
        color: #2c2418;
        margin-bottom: 14px;
        line-height: 1.6;
    }

    #translate-input {
        width: 95%;
        padding: 12px 18px;
        font-size: 1.15rem;
        font-weight: normal;
        border: 2px solid #ccc;
        border-radius: 10px;
        outline: none;
        margin-bottom: 15px;
        font-family: inherit;
        box-sizing: border-box;
    }
    #translate-input:focus { border-color: #8b2c2c; }

    .option-btn {
        display: block;
        width: 100%;
        text-align: left;
        padding: 12px 18px;
        margin: 8px 0;
        background-color: #fcf6e8;
        border: 3px solid transparent;
        border-radius: 10px;
        cursor: pointer;
        font-size: 1.05rem;
        line-height: 1.5;
        color: #2c2418;
        transition: all 0.15s ease;
        font-family: inherit;
        box-sizing: border-box;
    }
    .option-btn:hover:not(:disabled) {
        transform: translateY(-2px);
        border-color: #8b2c2c;
        background-color: #fef9ee;
    }
    .option-btn:disabled { cursor: not-allowed; opacity: 0.92; }
    .option-btn.correct { border-color: #2b7a78 !important; background-color: #def2f1 !important; color: #1c5b5a !important; }
    .option-btn.wrong { border-color: #c0392b !important; background-color: #fbe5e1 !important; color: #9b2d20 !important; }

    #sentence-feedback, #translate-feedback, #theme-feedback, #rhetoric-feedback {
        font-size: 1.1rem;
        font-weight: bold;
        min-height: 25px;
        margin: 12px 0 15px 0;
    }
    .feedback-correct { color: #2b7a78; }
    .feedback-wrong { color: #c0392b; }
    .feedback-hint {
        color: #7a6f5f;
        font-weight: normal;
        font-size: 0.95rem;
        margin-top: 8px;
        line-height: 1.5;
    }

    .btn-action {
        background-color: #8b2c2c;
        color: white;
        border: none;
        padding: 10px 30px;
        font-size: 1rem;
        font-weight: bold;
        border-radius: 30px;
        cursor: pointer;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }
    .btn-action:hover { background-color: #6e1f1f; }
    .btn-next {
        background-color: #b58a23;
        color: white;
        margin-left: 10px;
    }
    .btn-next:hover { background-color: #8e6a1a; }

    .reset-container { margin: 25px 0 10px 0; text-align: center; }

    .reference-box {
        background: #f0e8d5;
        border: 2px dashed #8b2c2c;
        padding: 15px 20px;
        margin: 15px 0;
        border-radius: 8px;
        font-size: 1rem;
        line-height: 1.7;
        color: #2c2418;
        display: none;
    }
    .reference-box.show { display: block; }
    .reference-title {
        font-weight: bold;
        color: #8b2c2c;
        margin-bottom: 6px;
    }

    .keyterm {
        color: #8b2c2c;
        font-weight: bold;
        text-decoration: underline dotted;
        cursor: help;
    }
</style>
</head>
<body>

<h1>📜 文言文溫習王:《論仁》篇</h1>
<p class="instructions">香港 DSE 中文言文應試練習 — 涵蓋字詞、句意、翻譯、主旨、手法、人物事跡</p>

<div class="score-banner" id="game-score-banner">
    <span id="score-label">🧩 字詞配對分數:</span>
    <span id="score-display-box">
        <span id="score-current">0</span> / <span id="score-full">100</span>
    </span>
</div>
<br>

<div class="mode-switcher">
    <button id="btn-mode-vocab" class="mode-btn active" onclick="switchGameMode('vocab')">🧩 字詞配對</button>
    <button id="btn-mode-sentence" class="mode-btn" onclick="switchGameMode('sentence')">📖 句意選擇</button>
    <button id="btn-mode-translate" class="mode-btn" onclick="switchGameMode('translate')">✍️ 翻譯填空</button>
    <button id="btn-mode-theme" class="mode-btn" onclick="switchGameMode('theme')">📌 主旨判斷</button>
    <button id="btn-mode-rhetoric" class="mode-btn" onclick="switchGameMode('rhetoric')">🎭 手法辨識</button>
    <button id="btn-mode-people" class="mode-btn" onclick="switchGameMode('people')">⚔️ 人物事跡</button>
</div>

<!-- MODE 1: 字詞配對 -->
<div id="vocab-view">
    <h2 class="title-1">字詞配對(16對)</h2>
    <p style="color:#6e604c;font-size:0.9rem;">點擊左邊文言詞語與右邊解釋配對。每對+10分,錯配-3分。兩列各自隨機排序。</p>
    <div class="vocab-board">
        <div>
            <div class="vocab-column-title">📖 文言詞語</div>
            <div id="vocab-terms"></div>
        </div>
        <div>
            <div class="vocab-column-title">💡 詞語解釋</div>
            <div id="vocab-defs"></div>
        </div>
    </div>
    <div class="reset-container">
        <button class="btn-action" onclick="buildVocabGame()">重洗字詞牌組 🔄</button>
    </div>
</div>

<!-- MODE 2: 句意選擇 -->
<div class="quiz-container" id="sentence-container">
    <div style="font-size:1rem;color:#7a6f5f;font-weight:bold;margin-bottom:5px;text-align:center;" id="sentence-progress">題目 1 / 8</div>
    <div class="passage-box" id="sentence-passage">文言句子</div>
    <div id="sentence-question">選擇最接近的白話翻譯:</div>
    <div id="sentence-options"></div>
    <div id="sentence-feedback"></div>
    <div style="text-align:center;">
        <button id="sentence-next-btn" class="btn-action btn-next" onclick="nextSentenceQuestion()" style="display:none;">下一題 ➡️</button>
    </div>
    <div class="reset-container">
        <button class="btn-action" style="background-color:#b58a23;" onclick="resetSentenceQuiz()">重新開始 🔄</button>
    </div>
</div>

<!-- MODE 3: 翻譯填空 -->
<div class="quiz-container" id="translate-container">
    <div style="font-size:1rem;color:#7a6f5f;font-weight:bold;margin-bottom:5px;text-align:center;" id="translate-progress">題目 1 / 6</div>
    <div class="passage-box" id="translate-passage">文言原句</div>
    <div id="translate-prompt">請輸入白話翻譯(批改會比對關鍵詞):</div>
    <input type="text" id="translate-input" placeholder="例如:不仁的人不可以長時間處於困窘之中" autocomplete="off">
    <div id="translate-feedback"></div>
    <div class="reference-box" id="translate-reference">
        <div class="reference-title">📖 參考譯文</div>
        <div id="translate-ref-text"></div>
    </div>
    <div style="text-align:center;">
        <button class="btn-action" onclick="checkTranslateAnswer()">提交答案</button>
        <button id="translate-next-btn" class="btn-action btn-next" onclick="nextTranslateQuestion()" style="display:none;">下一題 ➡️</button>
    </div>
    <div class="reset-container">
        <button class="btn-action" style="background-color:#b58a23;" onclick="resetTranslateQuiz()">重新開始 🔄</button>
    </div>
</div>

<!-- MODE 4: 主旨判斷 -->
<div class="quiz-container" id="theme-container">
    <div style="font-size:1rem;color:#7a6f5f;font-weight:bold;margin-bottom:5px;text-align:center;" id="theme-progress">題目 1 / 4</div>
    <div class="passage-box" id="theme-passage">章節原文</div>
    <div id="theme-question">此則最主要是說明:</div>
    <div id="theme-options"></div>
    <div id="theme-feedback"></div>
    <div style="text-align:center;">
        <button id="theme-next-btn" class="btn-action btn-next" onclick="nextThemeQuestion()" style="display:none;">下一題 ➡️</button>
    </div>
    <div class="reset-container">
        <button class="btn-action" style="background-color:#b58a23;" onclick="resetThemeQuiz()">重新開始 🔄</button>
    </div>
</div>

<!-- MODE 5: 手法辨識 -->
<div class="quiz-container" id="rhetoric-container">
    <div style="font-size:1rem;color:#7a6f5f;font-weight:bold;margin-bottom:5px;text-align:center;" id="rhetoric-progress">題目 1 / 4</div>
    <div class="passage-box" id="rhetoric-passage">章節原文</div>
    <div id="rhetoric-question">此段主要運用了什麼表現手法?</div>
    <div id="rhetoric-options"></div>
    <div id="rhetoric-feedback"></div>
    <div style="text-align:center;">
        <button id="rhetoric-next-btn" class="btn-action btn-next" onclick="nextRhetoricQuestion()" style="display:none;">下一題 ➡️</button>
    </div>
    <div class="reset-container">
        <button class="btn-action" style="background-color:#b58a23;" onclick="resetRhetoricQuiz()">重新開始 🔄</button>
    </div>
</div>

<!-- MODE 6: 人物事跡配對 -->
<div id="people-view">
    <h2 class="title-3">殺身成仁人物事跡(4對)</h2>
    <p style="color:#6e604c;font-size:0.9rem;">配對歷史人物與其名言。</p>
    <div class="grid" id="people-grid"></div>
    <div class="reset-container">
        <button class="btn-action" onclick="buildPeopleGame()">重洗人物牌組 🔄</button>
    </div>
</div>

<script>
/* ================= 數據庫 ================= */

// 模式 1: 字詞配對 (16對)
const vocabDatabase = [
    { term: "約", explain: "困窘、窮困" },
    { term: "安仁", explain: "因實踐仁德而心安" },
    { term: "利仁", explain: "認為仁德有利而行仁" },
    { term: "道", explain: "正當的方法" },
    { term: "處(不處)", explain: "接受、留處" },
    { term: "去", explain: "離開、擺脫" },
    { term: "造次", explain: "倉卒匆忙之時" },
    { term: "顛沛", explain: "困頓流離之際" },
    { term: "終食之間違仁", explain: "連吃一頓飯也不違背仁德" },
    { term: "克己", explain: "克制私慾" },
    { term: "復禮", explain: "使言行回歸禮的規範" },
    { term: "目", explain: "細目、具體綱目" },
    { term: "殺身成仁", explain: "犧牲生命以成全仁德" },
    { term: "忠", explain: "盡己之心,主動成全他人" },
    { term: "恕", explain: "將心比心、推己及人" },
    { term: "己所不欲,勿施於人", explain: "不願承受的不強加於人" }
];

// 模式 2: 句意選擇 (8題,4選1)
const sentenceDatabase = [
    {
        passage: "不仁者不可以久處約",
        question: "「不仁者不可以久處約」最貼切的白話是:",
        options: [
            { text: "不仁的人不可以長時間處於困窘中", correct: true },
            { text: "不仁的人不可以長時間居住", correct: false },
            { text: "不仁的人不可以處於富貴中", correct: false },
            { text: "不仁的人不能與人相處", correct: false }
        ]
    },
    {
        passage: "仁者安仁",
        question: "「仁者安仁」意思是:",
        options: [
            { text: "仁德的人生活安穩", correct: false },
            { text: "仁德的人因實踐仁德而心安", correct: true },
            { text: "仁德的人安於富貴", correct: false },
            { text: "仁德的人安於現狀", correct: false }
        ]
    },
    {
        passage: "知者利仁",
        question: "「知者利仁」意思是:",
        options: [
            { text: "聰明的人利用仁德", correct: false },
            { text: "聰明的人認為仁德有利而行仁", correct: true },
            { text: "聰明的人用仁來獲利", correct: false },
            { text: "聰明的人利益他人", correct: false }
        ]
    },
    {
        passage: "富與貴......不以其道得之,不處也",
        question: "「不以其道得之,不處也」意思是:",
        options: [
            { text: "若不以正當方法取得,君子絕不接受", correct: true },
            { text: "富貴人人都想要,不管方法", correct: false },
            { text: "富貴不靠正道就不會來", correct: false },
            { text: "富貴人人都想要,君子也不理會", correct: false }
        ]
    },
    {
        passage: "君子去仁,惡乎成名?",
        question: "「君子去仁,惡乎成名?」最貼切意思:",
        options: [
            { text: "君子離開仁,哪裏成名?", correct: false },
            { text: "君子違背仁,怎樣成就名聲?", correct: true },
            { text: "君子背棄仁,名聲還可以嗎?", correct: false },
            { text: "君子除去仁,哪需要名聲?", correct: false }
        ]
    },
    {
        passage: "造次必於是,顛沛必於是",
        question: "「造次必於是,顛沛必於是」意思:",
        options: [
            { text: "倉卒或困頓流離時,必定堅守仁德", correct: true },
            { text: "跌倒必定在這裏", correct: false },
            { text: "顛簸困頓必定如此", correct: false },
            { text: "匆忙和倒斃必定如此", correct: false }
        ]
    },
    {
        passage: "克己復禮為仁",
        question: "「克己復禮為仁」最貼切意思:",
        options: [
            { text: "剋制自己,回復禮貌,是仁", correct: false },
            { text: "克制私慾,使言行合於禮,就是仁", correct: true },
            { text: "戰勝自己,恢復禮節,是仁", correct: false },
            { text: "克服自己,恢復禮制,是仁", correct: false }
        ]
    },
    {
        passage: "殺身以成仁",
        question: "「殺身以成仁」意思是:",
        options: [
            { text: "殺害生命來完成仁", correct: false },
            { text: "犧牲生命來成全仁德", correct: true },
            { text: "殺身是為了變得仁慈", correct: false },
            { text: "殺害身體就是仁", correct: false }
        ]
    }
];

// 模式 3: 翻譯填空 (6題,批改關鍵詞)
const translateDatabase = [
    {
        passage: "不仁者不可以久處約,不可以長處樂。",
        reference: "不仁的人不可以長時間處於困窘之中,也不可以長時間處於安樂之中。",
        keywords: ["困窘", "安樂"]
    },
    {
        passage: "仁者安仁,知者利仁。",
        reference: "仁者因實踐仁德而心安,知者因仁德有利而行仁。",
        keywords: ["心安", "有利"]
    },
    {
        passage: "富與貴,是人之所欲也;不以其道得之,不處也。",
        reference: "富貴是人人都想要;若不以正當的方法取得,君子不會接受。",
        keywords: ["正當", "接受"]
    },
    {
        passage: "君子去仁,惡乎成名?",
        reference: "君子若離棄仁德,怎麼能成就名聲?",
        keywords: ["離棄", "名聲"]
    },
    {
        passage: "克己復禮為仁。一日克己復禮,天下歸仁焉。",
        reference: "克制私慾,使言行合於禮,就是仁。一旦人人克己復禮,天下便歸於仁了。",
        keywords: ["私慾", "合於禮"]
    },
    {
        passage: "志士仁人,無求生以害仁,有殺身以成仁。",
        reference: "志士仁人,不會為了苟且偷生而損害仁德,只會犧牲生命來成全仁德。",
        keywords: ["苟且偷生", "成全"]
    }
];

// 模式 4: 主旨判斷 (4題,每則1題)
const themeDatabase = [
    {
        passage: "子曰:「不仁者不可以久處約,不可以長處樂。仁者安仁,知者利仁。」",
        question: "此則最主要是說明:",
        options: [
            { text: "仁與智的分別", correct: false },
