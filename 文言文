/* ================= 工具函數 ================= */
function addGamePoints(amount) {
    gameScores[currentActiveTabKey] += amount;
    if (gameScores[currentActiveTabKey] < 0) gameScores[currentActiveTabKey] = 0;
    document.getElementById('score-current').textContent = gameScores[currentActiveTabKey];
}

function shuffle(array) {
    let arr = [...array];
    for (let i = arr.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [arr[i], arr[j]] = [arr[j], arr[i]];
    }
    return arr;
}

/* ================= MODE SWITCH ================= */
function switchGameMode(mode) {
    const tabs = ['vocab', 'sentence', 'translate', 'theme', 'rhetoric', 'people'];
    tabs.forEach(t => {
        const btn = document.getElementById(`btn-mode-${t}`);
        if (btn) btn.classList.remove('active');
        const view = document.getElementById(`${t}-view`);
        if (view) view.style.display = 'none';
        const container = document.getElementById(`${t}-container`);
        if (container) container.style.display = 'none';
    });

    const activeBtn = document.getElementById(`btn-mode-${mode}`);
    if (activeBtn) activeBtn.classList.add('active');
    const activeView = document.getElementById(`${mode}-view`);
    if (activeView) activeView.style.display = 'block';
    const activeContainer = document.getElementById(`${mode}-container`);
    if (activeContainer) activeContainer.style.display = 'block';

    currentActiveTabKey = mode;

    const labels = {
        vocab: "🧩 字詞配對分數:",
        sentence: "📖 句意選擇分數:",
        translate: "✍️ 翻譯填空分數:",
        theme: "📌 主旨判斷分數:",
        rhetoric: "🎭 手法辨識分數:",
        people: "⚔️ 人物事跡分數:"
    };
    document.getElementById('score-label').textContent = labels[mode];
    document.getElementById('score-current').textContent = gameScores[mode];
    document.getElementById('score-full').textContent = fullMarks[mode];

    if (mode === 'vocab') buildVocabGame();
    else if (mode === 'sentence') prepareSentenceQuiz();
    else if (mode === 'translate') prepareTranslateQuiz();
    else if (mode === 'theme') prepareThemeQuiz();
    else if (mode === 'rhetoric') prepareRhetoricQuiz();
    else if (mode === 'people') buildPeopleGame();
}

/* ================= MODE 1: 字詞配對 ================= */
function buildVocabGame() {
    vocabSelectionMemory = [];
    gameScores['vocab'] = 0;
    if (currentActiveTabKey === 'vocab') {
        document.getElementById('score-current').textContent = 0;
    }

    const termsCol = document.getElementById('vocab-terms');
    const defsCol = document.getElementById('vocab-defs');
    termsCol.innerHTML = '';
    defsCol.innerHTML = '';

    // 左列字詞:隨機排序
    const shuffledTerms = shuffle(vocabDatabase);
    shuffledTerms.forEach(item => {
        const el = document.createElement('div');
        el.className = 'card vocab-card';
        el.textContent = item.term;
        el.setAttribute('data-matchkey', item.term);
        el.onclick = function() { handleVocabClick(el); };
        termsCol.appendChild(el);
    });

    // 右列釋義:隨機排序
    const shuffledDefs = shuffle(vocabDatabase);
    shuffledDefs.forEach(item => {
        const el = document.createElement('div');
        el.className = 'card vocab-card';
        el.textContent = item.explain;
        el.setAttribute('data-matchkey', item.term);
        el.onclick = function() { handleVocabClick(el); };
        defsCol.appendChild(el);
    });
}

function handleVocabClick(element) {
    if (element.classList.contains('matched') || vocabSelectionMemory.includes(element)) return;
    if (vocabSelectionMemory.length >= 2) return;

    element.classList.add('selected');
    vocabSelectionMemory.push(element);

    if (vocabSelectionMemory.length === 2) {
        const c1 = vocabSelectionMemory[0];
        const c2 = vocabSelectionMemory[1];
        if (c1.getAttribute('data-matchkey') === c2.getAttribute('data-matchkey')) {
            setTimeout(() => {
                c1.className = 'card matched';
                c2.className = 'card matched';
                vocabSelectionMemory = [];
                addGamePoints(10);
            }, 250);
        } else {
            setTimeout(() => {
                c1.classList.remove('selected');
                c2.classList.remove('selected');
                vocabSelectionMemory = [];
                addGamePoints(-3);
            }, 800);
        }
    }
}

