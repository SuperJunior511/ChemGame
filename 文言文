        document.getElementById('sentence-feedback').innerHTML = "<span class='feedback-correct'>太棒了!</span>";
        document.getElementById('sentence-next-btn').style.display = 'none';
        return;
    }

    sentenceFirstTry = true;
    const q = sentenceDeck[sentenceIndex];
    document.getElementById('sentence-progress').textContent = `題目 ${sentenceIndex + 1} / ${sentenceDeck.length}`;
    document.getElementById('sentence-passage').textContent = q.passage;
    document.getElementById('sentence-question').textContent = q.question;

    const optsContainer = document.getElementById('sentence-options');
    optsContainer.innerHTML = "";
    const shuffledOpts = shuffle(q.options);
    shuffledOpts.forEach((opt, i) => {
        const btn = document.createElement('button');
        btn.className = 'option-btn';
        btn.textContent = `${String.fromCharCode(65 + i)}. ${opt.text}`;
        btn.setAttribute('data-correct', opt.correct ? '1' : '0');
        btn.onclick = function() { handleSentenceOption(this); };
        optsContainer.appendChild(btn);
    });

    document.getElementById('sentence-feedback').innerHTML = "";
    document.getElementById('sentence-next-btn').style.display = 'none';
}

function handleSentenceOption(btn) {
    if (document.getElementById('sentence-next-btn').style.display === 'inline-block') return;
    const isCorrect = btn.getAttribute('data-correct') === '1';
    const feedback = document.getElementById('sentence-feedback');
    document.querySelectorAll('#sentence-options .option-btn').forEach(b => b.disabled = true);

    if (isCorrect) {
        btn.classList.add('correct');
        feedback.innerHTML = "<span class='feedback-correct'>✓ 答對了!</span>";
        document.getElementById('sentence-next-btn').style.display = 'inline-block';
        document.getElementById('sentence-next-btn').focus();
        if (sentenceFirstTry) addGamePoints(20);
    } else {
        btn.classList.add('wrong');
        document.querySelectorAll('#sentence-options .option-btn').forEach(b => {
            if (b.getAttribute('data-correct') === '1') b.classList.add('correct');
        });
        feedback.innerHTML = "<span class='feedback-wrong'>✗ 再想想!</span><div class='feedback-hint'>提示:留意「約」、「安仁」、「利仁」等字面意思。</div>";
        sentenceFirstTry = false;
